#!/bin/sh
# Wine 앱에 데스크톱 연동을 앱 단위로 깔고 관리한다.
#  - comdlg32.dll: 파일 열기/저장 대화상자 → xdg-desktop-portal
#  - explorer.exe: "explorer /select,<경로>" 와 "explorer <폴더>" → 유닉스 파일 관리자(FileManager1)
# 사용:
#   wine-desktop-integration install <WINEPREFIX> <앱 exe 의 유닉스 경로>
#   wine-desktop-integration install [--pick "번호..."] [WINEPREFIX]   scan 목록에서 골라 설치(--pick 없으면 물음)
#   wine-desktop-integration uninstall <WINEPREFIX> <앱 exe 의 유닉스 경로>
#   wine-desktop-integration update                 목록의 앱 전부 다시 설치(build.sh 뒤에)
#   wine-desktop-integration status
#   wine-desktop-integration scan [WINEPREFIX]       설치 후보 나열(설치는 안 함)
# 앱 폴더에 사본을 두고 그 앱만 comdlg32=native,builtin override, 헬퍼는 $WDI_BIN_DIR(기본 ~/.local/bin)에 사본.
# 링크가 아니라 사본이라 이 저장소를 옮기거나 지워도 깔린 것은 동작한다. 원본은 이 스크립트 옆의 빌드 산출물.
# 설치한 앱 목록: ${XDG_DATA_HOME:-~/.local/share}/wine-desktop-integration/apps (한 줄에 "<prefix>\t<exe>")
# wine 은 $WINE 또는 PATH (reg add/delete 에만 씀). WINEPREFIX 생략 시 ${WINEPREFIX:-~/.wine}
# ponytail: 64비트(x86_64) 앱만. 32비트 앱은 i386 빌드와 i386-windows 사본이 필요
# ponytail: 목록이 탭·줄 단위라 경로에 탭/개행이 있으면 깨짐
set -eu
here=$(dirname -- "$(readlink -f -- "$0")")  # PATH 의 심볼릭 링크로 불려도 빌드 산출물 옆
helper=wine-desktop-integration-helper
bindir=${WDI_BIN_DIR:-$HOME/.local/bin}
apps=${XDG_DATA_HOME:-$HOME/.local/share}/wine-desktop-integration/apps
files="comdlg32.dll explorer.exe"
tab=$(printf '\t')

usage() { echo "사용:" >&2; grep '^#   wine-desktop-integration' "$0" | cut -c3- >&2; exit 2; }
die() { echo "$*" >&2; exit 1; }
# 우리 파일인지 (wine-portal-filedialog·comdlg32_wine 은 옛 버전 표지). 앱 자체 파일은 건드리지 않기 위함
ours() { grep -aqE 'wine-desktop-integration|wine-portal-filedialog|comdlg32_wine' "$1"; }
# 다르면 임시 파일에 쓴 뒤 mv (실행 중 매핑된 파일을 truncate 하지 않게)
put() {
    cmp -s "$1" "$2" && return 0
    cp -f "$1" "$2.tmp.$$" && mv -f "$2.tmp.$$" "$2" || { rm -f "$2.tmp.$$"; return 1; }
}
# 심볼릭 링크를 푼 절대경로 (목록·scan 비교가 같은 형태가 되게)
prefix() {
    p=$(cd -P "$1" 2>/dev/null && pwd) && [ -d "$p/drive_c" ] || die "WINEPREFIX 가 아님: $1"
    printf '%s' "$p"
}
exepath() {
    d=$(cd -P "$(dirname -- "$1")" 2>/dev/null && pwd) || die "폴더 없음: $(dirname -- "$1")"
    printf '%s/%s' "$d" "$(basename -- "$1")"
}
key() { printf '%s' "HKCU\\Software\\Wine\\AppDefaults\\$1\\DllOverrides"; }
reg() {
    p=$1; shift
    w=${WINE:-$(command -v wine || true)}
    [ -n "$w" ] || die "wine 을 찾을 수 없음"
    WINEPREFIX=$p "$w" reg "$@" >/dev/null 2>&1
}
# wine 을 띄우지 않고 user.reg 에서 확인
# ponytail: reg add 직후엔 wineserver 가 아직 안 써서 없다고 나올 수 있음(그러면 reg add 를 한 번 더 할 뿐).
#           비 ASCII 앱 이름은 user.reg 에서 \x 이스케이프라 못 찾음 → 같은 결과
has_override() {
    grep -iA100 -F "[Software\\\\Wine\\\\AppDefaults\\\\$2\\\\DllOverrides]" "$1/user.reg" 2>/dev/null |
        awk 'NR > 1 && /^\[/ { exit } 1' | grep -q '^"comdlg32"="native,builtin"$'
}
listed() { grep -qxF "$1$tab$2" "$apps" 2>/dev/null; }
# 같은 prefix 에 exe 이름이 $2 인 항목이 목록에 있는지 (override 키는 exe 이름 단위, 대소문자 무시)
named() {
    awk -F "$tab" -v p="$1" -v a="$2" '$1 == p { n = $2; sub(/.*\//, "", n); if (tolower(n) == tolower(a)) f = 1 }
        END { exit !f }' "$apps" 2>/dev/null
}
# 같은 폴더의 임시 파일에 쓴 뒤 mv. 실패하면 원래 목록 유지 (grep 종료코드 1 은 남는 줄이 없을 뿐)
unlist() {
    [ -f "$apps" ] || return 0
    tmp=$(mktemp "$apps.XXXXXX") || return 1
    if grep -vxF "$1$tab$2" "$apps" > "$tmp" || [ $? -eq 1 ]; then mv -f "$tmp" "$apps" && return 0; fi
    rm -f "$tmp"
    return 1
}

install_app() {  # <prefix> <exe> (둘 다 절대경로)
    appdir=${2%/*} app=${2##*/}
    for f in $files $helper; do
        [ -f "$here/$f" ] || die "$here/$f 없음: build.sh 먼저 실행"
    done
    [ -f "$2" ] || { echo "exe 없음: $2" >&2; return 1; }
    for f in $files; do
        if [ -e "$appdir/$f" ] && ! ours "$appdir/$f"; then
            echo "$appdir/$f 는 앱 자체 파일로 보임: 중단" >&2
            return 1
        fi
    done
    for f in $files; do put "$here/$f" "$appdir/$f" || return 1; done
    rm -f "$appdir/comdlg32_wine.dll"  # 옛 버전 흔적
    has_override "$1" "$app" || reg "$1" add "$(key "$app")" /v comdlg32 /d native,builtin /f || return 1
    mkdir -p "$bindir" "${apps%/*}" || return 1
    put "$here/$helper" "$bindir/$helper" || return 1
    listed "$1" "$2" || printf '%s\t%s\n' "$1" "$2" >> "$apps" || return 1
    echo "설치: $2"
}

uninstall_app() {  # <prefix> <exe>
    appdir=${2%/*} app=${2##*/}
    listed "$1" "$2" || die "목록에 없음: $2"
    unlist "$1" "$2" || die "목록을 고치지 못함: $apps"
    # 같은 폴더의 다른 앱이 아직 목록에 있으면 파일은 남김
    if ! cut -f2 "$apps" 2>/dev/null | sed 's|/[^/]*$||' | grep -qxF "$appdir"; then
        for f in $files; do
            if [ -f "$appdir/$f" ] && ours "$appdir/$f"; then rm -f "$appdir/$f"; fi
        done
        rm -f "$appdir/comdlg32_wine.dll"
    fi
    if ! named "$1" "$app" && has_override "$1" "$app"; then reg "$1" delete "$(key "$app")" /v comdlg32 /f || true; fi
    if [ ! -s "$apps" ] && [ -f "$bindir/$helper" ]; then rm -f "$bindir/$helper"; fi
    echo "제거: $2"
}

# 설치 후보 "<exe>\t<이름>" 을 경로순으로. scan 출력과 --pick 번호가 같은 순서를 쓴다
# 출처: winemenubuilder 가 만든 .desktop(Exec 의 WINEPREFIX 가 이 prefix), 레지스트리 Uninstall 키의 DisplayIcon
# ponytail: .reg 의 \xNNNN(비 ASCII) 은 풀지 않음 → 그런 경로는 존재 확인에서 빠지고 이름은 이스케이프된 채.
#           dosdevices 경로라 대소문자가 실제 파일과 다르면 빠짐. .lnk 를 여는 메뉴 항목도 건너뜀
candidates() {
    pfx=$1
    {
        find "${XDG_DATA_HOME:-$HOME/.local/share}/applications" -name '*.desktop' -type f \
                -exec awk -v OFS="$tab" '
            function flush(   s, c, i, n, q, tok, intok, t, p) {
                if (ex != "") {
                    s = ex; gsub(/\\\\/, "\\", s)  # 데스크톱 값 이스케이프 \\ → \
                    n = 0; tok = ""; q = 0; intok = 0
                    for (i = 1; i <= length(s); i++) {  # 셸식 토큰 분리
                        c = substr(s, i, 1)
                        if (c == "\\" && i < length(s)) { tok = tok substr(s, ++i, 1); intok = 1 }
                        else if (c == "\"") { q = !q; intok = 1 }
                        else if ((c == " " || c == "\t") && !q) { if (intok) t[++n] = tok; tok = ""; intok = 0 }
                        else { tok = tok c; intok = 1 }
                    }
                    if (intok) t[++n] = tok
                    i = (t[1] == "env") ? 2 : 1; p = ""
                    for (; i <= n && t[i] ~ /^[A-Za-z_][A-Za-z0-9_]*=/; i++)
                        if (t[i] ~ /^WINEPREFIX=/) p = substr(t[i], 12)
                    if (p != "" && t[i] ~ /(^|\/)wine(64)?$/) print p, t[i + 1], name
                }
                ex = name = ""
            }
            FNR == 1 { flush() }
            /^Name=/ && name == "" { name = substr($0, 6) }
            /^Exec=/ && ex == "" { ex = substr($0, 6) }
            END { flush() }' {} + 2>/dev/null || true
        awk -v OFS="$tab" -v pfx="$pfx" '
            function val(l) {
                sub(/^"[^"]*"=(str\(2\):)?"/, "", l); sub(/"[ \t]*$/, "", l)  # str(2): 는 REG_EXPAND_SZ
                gsub(/\\"/, "\"", l); gsub(/\\\\/, "\\", l); return l
            }
            function flush() {
                if (icon != "" && icon !~ /%[^%]+%/) { gsub(/"/, "", icon); sub(/,[ \t]*-?[0-9]+$/, "", icon); print pfx, icon, name }
                icon = name = ""
            }
            /^\[/ { flush(); sec = ($0 ~ /\\\\CurrentVersion\\\\Uninstall\\\\/); next }
            sec && /^"DisplayName"="/ { name = val($0) }
            sec && /^"DisplayIcon"=(str\(2\):)?"/ { icon = val($0) }
            END { flush() }' "$pfx/system.reg" "$pfx/user.reg" 2>/dev/null || true
    } | awk -F "$tab" -v OFS="$tab" '  # "X:\..\a.exe" → "x:/../a.exe", 언인스톨러·Package Cache(설치 꾸러미 보관소) 제외
        $2 ~ /^[A-Za-z]:\\/ && tolower($2) ~ /\.exe$/ && tolower($2) !~ /\\package cache\\/ {
            f = tolower($2); sub(/.*\\/, "", f); if (f ~ /^unins/) next
            u = tolower(substr($2, 1, 1)) ":" substr($2, 3); gsub(/\\/, "/", u)
            print $1, u, $3
        }' | {
        lastp= lastn=
        while IFS=$tab read -r p u name; do
            if [ "$p" != "$lastp" ]; then lastp=$p; lastn=$(cd -P "$p" 2>/dev/null && pwd || true); fi
            [ "$lastn" = "$pfx" ] && [ -f "$pfx/dosdevices/$u" ] || continue
            printf '%s\t%s\n' "$(exepath "$pfx/dosdevices/$u")" "$name"
        done
    } | sort -t "$tab" -k1,1 -u
}

scan() {  # <prefix>
    c=$(candidates "$1")
    [ -n "$c" ] || { echo "후보 없음: $1"; return 0; }
    n=0
    printf '%s\n' "$c" | while IFS=$tab read -r exe name; do
        n=$((n + 1))
        if listed "$1" "$exe"; then m='[설치됨]'; else m='        '; fi
        printf '%3d) %s %s  %s\n' "$n" "$m" "${name:-?}" "$exe"
    done
}

pick() {  # <prefix> <번호들>
    c=$(candidates "$1")
    [ -n "$c" ] || die "후보 없음: $1"
    total=$(printf '%s\n' "$c" | wc -l)
    for n in $2; do
        case $n in ''|*[!0-9]*) die "번호가 아님: $n" ;; esac
        [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || die "범위 밖 번호: $n"
    done
    rc=0
    for n in $2; do
        line=$(printf '%s\n' "$c" | sed -n "${n}p")
        install_app "$1" "${line%%"$tab"*}" || rc=1
    done
    return $rc
}

status() {
    [ -s "$apps" ] || { echo "설치된 앱 없음"; return 0; }
    while IFS=$tab read -r pfx exe; do
        if [ ! -f "$exe" ]; then echo "$exe: exe 없음 ($pfx)"; continue; fi
        line="$exe:"
        for f in $files; do
            if [ ! -f "${exe%/*}/$f" ]; then s=없음
            elif cmp -s "$here/$f" "${exe%/*}/$f"; then s=최신
            else s=다름; fi
            line="$line $f=$s"
        done
        if has_override "$pfx" "${exe##*/}"; then line="$line override=있음"; else line="$line override=없음"; fi
        echo "$line ($pfx)"
    done < "$apps"
    if [ ! -f "$bindir/$helper" ]; then s=없음; elif cmp -s "$here/$helper" "$bindir/$helper"; then s=최신; else s=다름; fi
    echo "헬퍼 $bindir/$helper: $s"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
install)
    picks=
    if [ "${1:-}" = --pick ]; then [ $# -ge 2 ] || usage; picks=$2; shift 2; fi
    if [ $# -eq 2 ] && [ -z "$picks" ]; then
        pfx=$(prefix "$1"); exe=$(exepath "$2")
        install_app "$pfx" "$exe"
    elif [ $# -le 1 ]; then
        pfx=$(prefix "${1:-${WINEPREFIX:-$HOME/.wine}}")
        if [ -z "$picks" ]; then
            [ -t 0 ] || die "터미널이 아님: --pick \"번호...\" 로 줄 것"
            scan "$pfx"
            printf '설치할 번호(공백 구분): '
            read -r picks
        fi
        pick "$pfx" "$picks"
    else usage; fi ;;
uninstall)
    [ $# -eq 2 ] || usage
    # prefix·폴더가 사라져 목록에만 남은 항목은 건드릴 파일이 없으니 목록에서만 뺀다
    if listed "$1" "$2" && { [ ! -d "$1/drive_c" ] || [ ! -d "$(dirname -- "$2")" ]; }; then
        unlist "$1" "$2" || die "목록을 고치지 못함: $apps"
        echo "목록에서만 뺌(prefix 또는 폴더 없음): $2"
        exit 0
    fi
    pfx=$(prefix "$1"); exe=$(exepath "$2")
    uninstall_app "$pfx" "$exe" ;;
update)
    [ $# -eq 0 ] || usage
    entries=$(cat "$apps" 2>/dev/null || true)
    [ -n "$entries" ] || { echo "설치된 앱 없음"; exit 0; }
    rc=0
    # 없는 것은 외장 드라이브가 잠시 빠진 것일 수 있어 건너뛰기만 함 (목록에서 빼는 건 uninstall)
    while IFS=$tab read -r pfx exe; do
        if [ ! -d "$pfx/drive_c" ]; then  # 없는 prefix 에 wine reg 를 돌리면 새로 만들어짐
            echo "경고: prefix 없음, 건너뜀: $pfx" >&2
            continue
        fi
        if [ ! -f "$exe" ]; then
            echo "경고: exe 없음, 건너뜀: $exe" >&2
            continue
        fi
        install_app "$pfx" "$exe" || rc=1
    done <<EOF
$entries
EOF
    exit $rc ;;
status) [ $# -eq 0 ] || usage; status ;;
scan)
    [ $# -le 1 ] || usage
    pfx=$(prefix "${1:-${WINEPREFIX:-$HOME/.wine}}")
    scan "$pfx" ;;
*) usage ;;
esac
